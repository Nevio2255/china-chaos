{
  "name": "china-chaos",
  "version": "5.3.1",
  "description": "China Chaos - Multiplayer Arcade Game",
  "author": "Nevio2255",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",

  "repository": {
    "type": "git",
    "url": "https://github.com/Nevio2255/china-chaos.git"
  },

  "engines": {
    "node": "22.x"
  },

  "scripts": {
    "build": "vite build client",
    "start": "vite build client && node server/index.js",
    "start:prod": "node server/index.js",
    "desktop": "electron desktop/main.cjs",
    "desktop:build": "electron-builder --win nsis --publish never"
  },

  "dependencies": {
    "@discord/embedded-app-sdk": "^1.4.0",
    "better-sqlite3": "^11.3.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5",
    "electron-updater": "6.6.2",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "vite": "^5.4.0"
  },

  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "26.15.3"
  },

  "build": {
    "appId": "com.chinachaos.game",
    "productName": "China Chaos",
    "executableName": "China Chaos",

    "directories": {
      "output": "dist-desktop"
    },

    "files": [
      "desktop/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/lazy-val/**/*",
      "package.json"
    ],

    "asar": true,

    "npmRebuild": false,

    "publish": [
      {
        "provider": "github",
        "owner": "Nevio2255",
        "repo": "china-chaos",
        "releaseType": "release"
      }
    ],

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],

      "icon": "desktop/build/icon.ico",

      "artifactName": "ChinaChaos-Setup-${version}.${ext}"
    },

    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,

      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,

      "shortcutName": "China Chaos",

      "deleteAppDataOnUninstall": false
    }
  }
}
