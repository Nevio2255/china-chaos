{
  "name": "china-chaos-desktop",
  "version": "5.3.0",
  "description": "China Chaos Desktop Edition",
  "author": "China Chaos",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.chinachaos.game",
    "productName": "China Chaos",
    "files": ["main.cjs", "build/icon.ico", "build/icon.png"],
    "directories": { "buildResources": "build" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "China Chaos"
    },
    "publish": [{ "provider": "github", "owner": "Nevio2255", "repo": "china-chaos" }],
    "artifactName": "ChinaChaos-Setup-${version}.${ext}"
  }
}
